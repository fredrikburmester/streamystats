{
  "name": "@streamystats/nextjs-app",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "bun --bun next dev --turbopack",
    "build": "NODE_ENV=production bun --bun next build --turbopack --experimental-build-mode compile",
    "start": "bun --bun next start",
    "start:standalone": "bun run .next/standalone/apps/nextjs-app/server.js",
